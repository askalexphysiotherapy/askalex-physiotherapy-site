# Google Places — live reviews on the About page
#
# 1. Google Cloud Console → enable "Places API"
# 2. Create an API key (restrict to Places API / your domains)
# 3. Find your Place ID:
#    https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#    Search "Ask Alex Physiotherapy"
# 4. Optional: paste your preferred Business Profile / reviews share link
#    (from Google Business Profile → Share). If omitted, we use Google's
#    reviews page for your Place ID.

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_BUSINESS_PROFILE_URL=
